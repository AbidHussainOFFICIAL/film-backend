# Copy this file to .env and fill in your real values.
# Never commit the real .env file to git.

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
PORT=5000

# --- Ingestion script (scripts/ingest.js) ---
# Free key: sign up at https://www.themoviedb.org/signup, then generate one
# at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional overrides for the ingestion script (both have sensible defaults):
# Archive.org collection to pull from
INGEST_COLLECTION=prelinger
# Max items pulled per run
INGEST_ROWS=20

# --- Firebase Admin (protects /api/admin/* routes) ---
# Firebase Console → Project settings → Service accounts → Generate new private key.
# That downloads a JSON file — copy the matching fields from it below.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Keep the quotes and the literal \n sequences exactly as they appear in the
# downloaded JSON's "private_key" field — the script unescapes them at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT\n-----END PRIVATE KEY-----\n"

# --- Semantic search (Nomic embeddings + Qdrant) ---
# atlas.nomic.ai → sign up → API keys → create key
# Free tier: one-time 1M token allowance, no credit card required
NOMIC_API_KEY=your_nomic_api_key
# Qdrant Cloud free cluster: qdrant.tech → create cluster → copy URL + API key
QDRANT_URL=https://your-cluster-id.your-region.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
# Name of the collection this app uses — created automatically if missing
QDRANT_COLLECTION=films
# Minimum cosine similarity (0-1) for a search result to count as relevant.
# Optional — defaults to 0.45 in code if omitted. Raise it if irrelevant
# films show up; lower it if genuinely relevant ones get filtered out.
SEARCH_SCORE_THRESHOLD=0.45
