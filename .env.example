# Copy this file to .env and fill in your real values.
# Never commit the real .env file to git.

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
PORT=5000

# --- Firebase Admin (protects /api/admin/* routes) ---
# Firebase Console → Project settings → Service accounts → Generate new private key.
# That downloads a JSON file — copy the matching fields from it below.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Keep the quotes and the literal \n sequences exactly as they appear in the
# downloaded JSON's "private_key" field — the script unescapes them at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT\n-----END PRIVATE KEY-----\n"

# --- Semantic search (Nomic embeddings + Qdrant) ---
# Used directly by this backend for: search queries, and embedding a
# single film right when it's approved. The bulk reindex-everything job
# runs on the heavy backend instead (see GITHUB_HEAVY_* below) — it has
# its own separate copy of these same credentials.
# atlas.nomic.ai → sign up → API keys → create key
# Free tier: one-time 1M token allowance, no credit card required
NOMIC_API_KEY=your_nomic_api_key
# Qdrant Cloud free cluster: qdrant.tech → create cluster → copy URL + API key
QDRANT_URL=https://your-cluster-id.your-region.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
# Name of the collection this app uses — created automatically if missing
QDRANT_COLLECTION=films
# Minimum cosine similarity (0-1) for a search result to count as relevant.
# Optional — defaults to 0.45 in code if omitted. Raise it if irrelevant
# films show up; lower it if genuinely relevant ones get filtered out.
SEARCH_SCORE_THRESHOLD=0.45

# --- Own content upload pipeline: storage (R2) ---
# Cloudflare dashboard → R2 → Manage API Tokens → create token with
# Object Read & Write permissions, scoped to your bucket. This backend
# only issues presigned upload URLs and uploads small files (captions) —
# it never touches the master video file's bytes. The heavy backend has
# its own separate, more broadly-scoped copy of these same credentials
# for downloading/uploading the actual video files.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your-bucket-name
# The custom domain connected to the bucket (R2 → bucket → Settings →
# Connect Domain) — this is what makes uploaded files publicly playable.
R2_PUBLIC_BASE_URL=https://media.yourdomain.com

# --- Captions (Deepgram) ---
# console.deepgram.com → sign up (no card needed) → API Keys → create key
# $200 free credit — Deepgram fetches your R2 URL itself, nothing heavy
# runs on this server.
DEEPGRAM_API_KEY=your_deepgram_api_key

# --- Heavy backend (film-media-worker GitHub repo) ---
# This backend never runs ffmpeg, ingestion, or bulk reindexing itself —
# it dispatches those as jobs to a separate repo's GitHub Actions
# workflows, and that repo calls back here with results.
#
# Fine-grained PAT scoped to just that repo, with Actions: read+write
# permission. github.com → Settings → Developer settings → Fine-grained tokens
GITHUB_PAT=your_github_personal_access_token
GITHUB_HEAVY_REPO_OWNER=your-github-username
GITHUB_HEAVY_REPO_NAME=film-media-worker
GITHUB_HEAVY_REPO_REF=main

# Shared secret the heavy backend sends back on every callback request —
# must exactly match the SERVICE_API_SECRET repo secret set in that repo.
# Protects the /api/service/* routes (jobs, uploads callback, film lookups
# for embedding) — these are called by CI jobs, not browsers, so they use
# this instead of a Firebase token.
SERVICE_API_SECRET=choose_a_long_random_string

# Optional — tags Sentry events by environment (development/production).
# Most hosting platforms set this automatically; safe to leave unset locally.
NODE_ENV=development

# --- Error tracking (Sentry) ---
# sentry.io → sign up (free tier) → create a project (platform: Node.js)
# → Settings → Client Keys (DSN) → copy the DSN value.
# The heavy backend's ingest.js/qdrantReindex.js scripts use the same DSN
# (as a repo secret there) — both report into one Sentry project, tagged
# by service name so they're distinguishable.
SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0

# --- Telegram channel auto-posting ---
# 1. Message @BotFather on Telegram → /newbot → follow the prompts → copy the token
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# 2. Create a Telegram channel, add your bot as admin with "Post Messages" permission.
# Channel ID looks like -1001234567890 (get it by forwarding a channel post to
# @userinfobot, or via the channel's public @username if it's public).
TELEGRAM_CHANNEL_ID=your_channel_id
# 3. Self-hosted Bot API server URL (raises the 50MB default limit to 2GB —
# needed since own-uploads can easily exceed 50MB). Testing setup: a Hugging
# Face Space running tdlib/telegram-bot-api, kept alive with a cron-job.com
# ping. Leave unset to fall back to Telegram's default api.telegram.org
# (fine for small archive.org films, will fail for larger own-uploads).
TELEGRAM_API_ROOT=https://your-space-name.hf.space

# Used to build the "watch it here" link in each Telegram post's caption.
# Optional — the caption just omits the link if this isn't set.
PUBLIC_SITE_URL=https://your-deployed-frontend.com

# --- WhatsApp channel auto-posting (unofficial, via Baileys) ---
# Not the official WhatsApp Cloud API — see README section 12 for why,
# and the real risk (this is outside Meta's ToS for automation, use a
# dedicated number you're OK potentially losing, never a personal one).
#
# Get this by running (after creating a WhatsApp Channel and adding this
# dedicated number as its admin):
#   npm run whatsapp:setup -- YOUR_CHANNEL_INVITE_CODE
# (the invite code is the part after whatsapp.com/channel/ in the
# channel's invite link). First run prints a QR code to the terminal —
# scan it with the dedicated WhatsApp account.
WHATSAPP_CHANNEL_JID=your_channel_jid_here

# Optional — shown to anyone who messages the paired number directly,
# since it only exists to post to the channel, not to chat.
WHATSAPP_AUTO_REPLY_TEXT=This number only posts to our channel and doesn't read replies here. Follow the channel for updates.

# --- Backblaze B2 ---
B2_ENDPOINT=https://s3.<region>.backblazeb2.com
B2_REGION=<region>              # e.g. us-west-004 — same segment as in B2_ENDPOINT
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET=
B2_PUBLIC_BASE_URL=             # e.g. https://f005.backblazeb2.com/file/your-bucket, or your own CDN in front

# --- Storj ---
STORJ_ACCESS_KEY_ID=
STORJ_SECRET_ACCESS_KEY=
STORJ_BUCKET=
STORJ_REGION=us-east-1
STORJ_LINKSHARE_BASE_URL=       # persistent read-only Linksharing base URL — see StorjAdapter.js header comment

# --- Internet Archive backup ---
IA_ACCESS_KEY=                  # archive.org/account/s3.php
IA_SECRET_KEY=

